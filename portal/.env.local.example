# ─────────────────────────────────────────────────────────────────────────────
# Portal config template — copy to `.env.local` and fill in YOUR values.
#
#   cp .env.local.example .env.local
#
# ⛔ NEVER PUT THESE IN ANY .env FILE:
#    • Wallet seed phrase / mnemonic
#    • Solana private key
#    • Your agent wallet's secret key
#
# Seed phrases only go in Turnkey's Import Iframe (browser, encrypted).
# Agent wallet keys live in GCP Secret Manager after `npm run gcp:bootstrap`.
#
# This file is committed to git ON PURPOSE — it has no secrets, only empty
# placeholders showing which settings exist.
# ─────────────────────────────────────────────────────────────────────────────

# GCP — links phone to CLI-provisioned wallet
GCP_PROJECT_ID=
# Vercel only — full service account JSON (Secret Manager read access)
# GCP_SERVICE_ACCOUNT_JSON=

# Turnkey *dashboard* API keys (NOT your wallet seed — these authenticate
# API calls to turnkey.com, like a service account password)
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_ORGANIZATION_ID=
TURNKEY_API_BASE_URL=https://api.turnkey.com

# Browser Passkey client (public org ID + your deployed domain)
NEXT_PUBLIC_TURNKEY_ORGANIZATION_ID=
NEXT_PUBLIC_RP_ID=localhost
NEXT_PUBLIC_TURNKEY_API_BASE_URL=https://api.turnkey.com

# Agent auto-signs below this amount (SOL)
AUTO_SIGN_THRESHOLD_SOL=0.5

# Optional — demo "Simulate Agent Request" button only
SOLANA_RPC_URL=https://api.devnet.solana.com
DEMO_RECIPIENT_ADDRESS=11111111111111111111111111111112
